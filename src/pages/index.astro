---
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const stages = [
  { index: "01", label: "Construct", title: "Canonical data", detail: "Chat records, embedding pairs, trajectories, provenance, rights, and split groups." },
  { index: "02", label: "Distill", title: "Teacher candidates", detail: "Generate responses, vectors, scores, or rankings—with separate judges and explicit budgets." },
  { index: "03", label: "Train", title: "Bound recipes", detail: "Pin datasets, templates, model revisions, objectives, and every field that makes resume honest." },
  { index: "04", label: "Evaluate", title: "Comparable evidence", detail: "Keep held-out answers held out. Compare only reports that share compatible identities." },
  { index: "05", label: "Export", title: "Verifiable artifacts", detail: "Ship model files with relative paths, byte sizes, SHA-256 hashes, and the receipt that produced them." }
];

const capabilities = [
  ["CHAT", "Full tool trajectories", "Train the call, the result, and the final answer—not merely the decision to use a tool."],
  ["EMBED", "Task-native records", "Retrieval, similarity, classification, and clustering keep their own semantics instead of sharing a vague universal schema."],
  ["CONTROL", "Fail-closed execution", "Network, spend, downloads, remote code, uploads, GPU paths, and mutation require explicit authorization."],
  ["RECOVERY", "Identity-aware resume", "A checkpoint resumes only when the immutable dataset and recipe identity still match."],
  ["PROOF", "Evidence before claims", "Production recipes remain unavailable until license, hardware, reload, and evaluation gates have passed."],
  ["AGENTS", "A CLI that explains itself", "Predictable noun-and-verb commands, JSON on stdout, diagnostics on stderr, and dry-runs before writes."]
];
---

<BaseLayout
  title={`${siteConfig.name} | Reproducible model training workflows`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <main class="landing">
    <section class="hero shell">
      <div class="hero__eyebrow reveal" style="--delay: 0ms">
        <span class="status-dot"></span>
        <span>agent-native model laboratory</span>
        <span class="hero__version">private alpha · 0.0.x</span>
      </div>

      <div class="hero__grid">
        <div class="hero__copy reveal" style="--delay: 90ms">
          <h1>
            Fine-tuning,<br />
            <em>with receipts.</em>
          </h1>
          <p class="hero__lede">
            Build chat and embedding datasets, distill frontier-model behavior, train open models,
            evaluate the result, and export artifacts you can trace all the way back to the data.
          </p>
          <div class="hero__actions">
            <a class="action action--primary" href="/docs/quickstart">
              <span>Run the offline quickstart</span><span aria-hidden="true">↗</span>
            </a>
            <a class="action action--secondary" href="https://github.com/amxv/finetuning">
              <span>Read the source</span><span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="run-card reveal" style="--delay: 180ms" aria-label="Example reproducible training run">
          <div class="run-card__top">
            <div><span class="run-card__dot"></span> run_7d0f2a</div>
            <span>verified</span>
          </div>
          <div class="run-card__body">
            <div class="run-card__rail" aria-hidden="true"></div>
            <div class="run-event">
              <span class="run-event__icon">D</span>
              <div><small>DATASET</small><strong>chat-receptionist-v4</strong><code>sha256: 9c72…d81a</code></div>
              <span class="run-event__state">frozen</span>
            </div>
            <div class="run-event">
              <span class="run-event__icon">T</span>
              <div><small>TEACHER</small><strong>frontier candidate pass</strong><code>budget: explicit · judge: separate</code></div>
              <span class="run-event__state">accepted</span>
            </div>
            <div class="run-event">
              <span class="run-event__icon">R</span>
              <div><small>RECIPE</small><strong>qwen · tool trajectory SFT</strong><code>template + tokenizer pinned</code></div>
              <span class="run-event__state">bound</span>
            </div>
            <div class="run-event">
              <span class="run-event__icon">A</span>
              <div><small>ARTIFACT</small><strong>portable model export</strong><code>17 files · all hashes match</code></div>
              <span class="run-event__state">verified</span>
            </div>
          </div>
          <div class="run-card__foot"><span>one chain of identities</span><span>not a folder of guesses</span></div>
        </div>
      </div>

      <div class="command-strip reveal" style="--delay: 270ms">
        <span class="command-strip__prompt">$</span>
        <code>finetuning distill plan --root tmp/run --json</code>
        <button class="copy-command" type="button" data-copy-command aria-label="Copy command">copy</button>
      </div>
    </section>

    <section class="manifesto shell reveal">
      <p class="section-kicker">THE PROBLEM</p>
      <p class="manifesto__statement">
        A training script is easy. The hard part is remembering <em>what actually happened</em>.
      </p>
      <div class="manifesto__body">
        <p>
          Which records went in? Which prompt shaped them? Did related examples leak across the
          split? Which model generated a candidate, which model judged it, and did resume quietly
          buy the same provider response twice?
        </p>
        <p>
          <strong>finetuning turns those questions into contracts.</strong> Every stage hands the next
          one a stable identity and an inspectable receipt instead of another unlabeled directory.
        </p>
      </div>
    </section>

    <section class="pipeline shell">
      <div class="section-head reveal">
        <div><p class="section-kicker">THE WORKFLOW</p><h2>One path from behavior to proof.</h2></div>
        <p>TypeScript owns data and orchestration. Python owns model execution. Versioned contracts keep the boundary honest.</p>
      </div>
      <div class="pipeline__list">
        {stages.map((stage, i) => (
          <article class="pipeline-step reveal" style={`--delay: ${i * 60}ms`}>
            <div class="pipeline-step__number">{stage.index}</div>
            <div class="pipeline-step__label">{stage.label}</div>
            <h3>{stage.title}</h3>
            <p>{stage.detail}</p>
            <span class="pipeline-step__arrow" aria-hidden="true">→</span>
          </article>
        ))}
      </div>
    </section>

    <section class="trajectory shell reveal">
      <div class="trajectory__copy">
        <p class="section-kicker">FULL TOOL TRAJECTORIES</p>
        <h2>The row does not stop at the tool call.</h2>
        <p>
          Choosing <code>check_availability</code> is only half the behavior. The student also needs to
          read the result, preserve the user’s constraints, and close the loop naturally.
        </p>
        <a href="/docs/full-tool-trajectories">Explore the trajectory format <span>↗</span></a>
      </div>
      <div class="conversation" aria-label="Example full tool trajectory">
        <div class="message message--user"><span>USER</span><p>Do you have anything after 4 on Thursday?</p></div>
        <div class="message message--assistant"><span>ASSISTANT · TOOL CALL</span><p><code>check_availability({`{ day: "thursday", after: "16:00" }`})</code></p></div>
        <div class="message message--tool"><span>TOOL RESULT</span><p><code>{`{ slots: ["16:30", "17:15"] }`}</code></p></div>
        <div class="message message--assistant message--final"><span>ASSISTANT · FINAL</span><p>Yes — 4:30 PM and 5:15 PM are both open. Which works better?</p></div>
      </div>
    </section>

    <section class="capabilities shell">
      <div class="section-head reveal">
        <div><p class="section-kicker">WHAT IT PRESERVES</p><h2>The machinery around the model.</h2></div>
        <p>The product is not another wrapper around a trainer. It is the control plane between every step.</p>
      </div>
      <div class="capabilities__grid">
        {capabilities.map(([tag, title, body], i) => (
          <article class="capability reveal" style={`--delay: ${i * 45}ms`}>
            <span>{tag}</span><h3>{title}</h3><p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="tracks shell">
      <div class="track track--chat reveal">
        <div class="track__label">01 / CHAT</div>
        <h2>Teach behavior.</h2>
        <p>Generate conversations, complete tool trajectories, response candidates, judge decisions, and canonical SFT data.</p>
        <ul><li>Scenario-driven self-play</li><li>OpenAI and Anthropic teachers</li><li>Separate generation and judging budgets</li><li>Held-out answer locks</li></ul>
        <a href="/docs/chat-track">Open the chat workflow ↗</a>
      </div>
      <div class="track track--embed reveal" style="--delay: 80ms">
        <div class="track__label">02 / EMBEDDINGS</div>
        <h2>Teach geometry.</h2>
        <p>Build retrieval and task datasets, mine negatives, distill vectors, scores, or rankings, and compare compatible evaluations.</p>
        <ul><li>Retrieval, STS, classification, clustering</li><li>Group-aware split isolation</li><li>Late-bound prompts and pooling</li><li>Recall, MRR, and task metrics</li></ul>
        <a href="/docs/embedding-quickstart">Open the embedding workflow ↗</a>
      </div>
    </section>

    <section class="safety shell reveal">
      <div class="safety__mark">!</div>
      <div class="safety__copy"><p class="section-kicker">HONEST BY DEFAULT</p><h2>A credential is not permission.</h2></div>
      <div class="safety__body">
        <p>Provider calls require an exact model, an environment-variable reference, network opt-in, and a positive budget.</p>
        <p>Downloads, uploads, GPU recipes, remote code, overwrites, and live infrastructure mutation stay explicit—or unavailable.</p>
      </div>
    </section>

    <section class="closing shell reveal">
      <div class="closing__hash">sha256: evidence-over-vibes</div>
      <h2>Build the model.<br /><em>Keep the history.</em></h2>
      <p>Start entirely offline with deterministic fixtures. No credentials, network, model download, GPU, upload, or remote code required.</p>
      <div class="hero__actions">
        <a class="action action--primary" href="/docs/quickstart"><span>Start building</span><span>↗</span></a>
        <a class="action action--secondary" href="/docs"><span>Browse every guide</span><span>↗</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const button = document.querySelector("[data-copy-command]");
  button?.addEventListener("click", async () => {
    await navigator.clipboard.writeText("finetuning distill plan --root tmp/run --json");
    button.textContent = "copied";
    window.setTimeout(() => (button.textContent = "copy"), 1400);
  });

  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) if (entry.isIntersecting) entry.target.classList.add("is-visible");
  }, { threshold: 0.08 });
  document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap');

  :root {
    --ft-ink: #171713;
    --ft-paper: #f1f0e8;
    --ft-acid: #c7f000;
    --ft-orange: #ff6234;
    --ft-blue: #91b5ff;
    --ft-line: rgba(23, 23, 19, .18);
    --ft-muted: #67675f;
    --ft-mono: "DM Mono", monospace;
    --ft-sans: "Manrope", sans-serif;
    --ft-serif: "Instrument Serif", serif;
  }

  html[data-theme="dark"] {
    --ft-ink: #f2f0e7;
    --ft-paper: #121310;
    --ft-line: rgba(242, 240, 231, .17);
    --ft-muted: #aaa99f;
  }

  body { background: var(--ft-paper); }
  .landing { color: var(--ft-ink); font-family: var(--ft-sans); overflow: hidden; }
  .landing * { box-sizing: border-box; }
  .landing .shell { width: min(1280px, calc(100% - 40px)); margin-inline: auto; }
  .landing code, .landing button { font-family: var(--ft-mono); }

  .hero { padding-top: clamp(3rem, 7vw, 7rem); padding-bottom: 5rem; }
  .hero__eyebrow { display: flex; align-items: center; gap: .7rem; border-top: 1px solid var(--ft-line); padding-top: .8rem; font: 500 .68rem/1 var(--ft-mono); letter-spacing: .12em; text-transform: uppercase; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ft-acid); box-shadow: 0 0 0 5px color-mix(in srgb, var(--ft-acid) 18%, transparent); }
  .hero__version { margin-left: auto; color: var(--ft-muted); }
  .hero__grid { display: grid; grid-template-columns: 1.02fr .98fr; gap: clamp(3rem, 7vw, 8rem); align-items: center; min-height: 660px; padding: 5rem 0 3.5rem; }
  .hero h1 { margin: 0; max-width: 760px; font: 400 clamp(5rem, 9.5vw, 9.3rem)/.78 var(--ft-serif); letter-spacing: -.055em; }
  .hero h1 em, .closing h2 em { color: var(--ft-orange); font-weight: 400; }
  .hero__lede { max-width: 670px; margin: 2.5rem 0 0; font-size: clamp(1.08rem, 1.5vw, 1.42rem); line-height: 1.65; color: var(--ft-muted); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2.5rem; }
  .action { display: inline-flex; align-items: center; justify-content: space-between; gap: 2rem; min-width: 230px; padding: 1rem 1.1rem; border: 1px solid var(--ft-ink); text-decoration: none; font: 600 .75rem/1 var(--ft-mono); text-transform: uppercase; letter-spacing: .04em; transition: transform .2s ease, background .2s ease, color .2s ease; }
  .action:hover { transform: translateY(-3px); }
  .action--primary { background: var(--ft-ink); color: var(--ft-paper); }
  .action--secondary { color: var(--ft-ink); }
  .action--secondary:hover { background: var(--ft-acid); color: #171713; }

  .run-card { position: relative; border: 1px solid var(--ft-ink); background: color-mix(in srgb, var(--ft-paper) 92%, var(--ft-blue)); box-shadow: 18px 18px 0 var(--ft-blue); transform: rotate(1.2deg); }
  .run-card__top, .run-card__foot { display: flex; justify-content: space-between; padding: .75rem 1rem; font: 500 .62rem/1 var(--ft-mono); letter-spacing: .07em; text-transform: uppercase; }
  .run-card__top { border-bottom: 1px solid var(--ft-line); }
  .run-card__dot { display: inline-block; width: 7px; height: 7px; margin-right: .5rem; border-radius: 50%; background: var(--ft-acid); }
  .run-card__foot { border-top: 1px solid var(--ft-line); color: var(--ft-muted); }
  .run-card__body { position: relative; padding: 1.6rem 1rem; }
  .run-card__rail { position: absolute; left: 2.05rem; top: 2.3rem; bottom: 2.3rem; width: 1px; background: var(--ft-line); }
  .run-event { position: relative; display: grid; grid-template-columns: 2.1rem 1fr auto; align-items: start; gap: .85rem; padding: .85rem 0; }
  .run-event__icon { z-index: 1; display: grid; place-items: center; width: 2.1rem; aspect-ratio: 1; border: 1px solid var(--ft-ink); background: var(--ft-paper); font: 500 .72rem var(--ft-mono); }
  .run-event div { display: grid; gap: .26rem; }
  .run-event small, .run-event code, .run-event__state { font: 400 .58rem/1.3 var(--ft-mono); letter-spacing: .05em; }
  .run-event small, .run-event code { color: var(--ft-muted); }
  .run-event strong { font-size: .86rem; }
  .run-event__state { padding: .32rem .45rem; background: var(--ft-acid); color: #171713; text-transform: uppercase; }
  .command-strip { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; border-block: 1px solid var(--ft-line); padding: 1rem 0; }
  .command-strip__prompt { color: var(--ft-orange); font: 500 1rem var(--ft-mono); }
  .command-strip code { overflow: hidden; color: var(--ft-muted); font-size: .78rem; text-overflow: ellipsis; white-space: nowrap; }
  .copy-command { border: 0; background: none; color: var(--ft-ink); cursor: pointer; font-size: .66rem; text-transform: uppercase; }

  .section-kicker { margin: 0 0 1rem; font: 500 .67rem/1 var(--ft-mono); letter-spacing: .13em; color: var(--ft-orange); }
  .manifesto { display: grid; grid-template-columns: .34fr 1.66fr; border-top: 1px solid var(--ft-line); padding-block: 8rem; }
  .manifesto__statement { grid-column: 2; margin: 0; max-width: 1100px; font: 400 clamp(3.2rem, 6.8vw, 7rem)/.98 var(--ft-serif); letter-spacing: -.035em; }
  .manifesto__statement em { color: var(--ft-orange); font-weight: 400; }
  .manifesto__body { grid-column: 2; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; margin-top: 3.5rem; color: var(--ft-muted); font-size: 1rem; line-height: 1.75; }
  .manifesto__body strong { color: var(--ft-ink); }

  .section-head { display: grid; grid-template-columns: 1.2fr .8fr; gap: 4rem; align-items: end; margin-bottom: 3rem; }
  .section-head h2, .trajectory h2, .safety h2 { margin: 0; font: 400 clamp(3rem, 5vw, 5.6rem)/.95 var(--ft-serif); letter-spacing: -.035em; }
  .section-head > p { max-width: 500px; margin: 0; color: var(--ft-muted); line-height: 1.7; }
  .pipeline { padding-block: 7rem; border-top: 1px solid var(--ft-line); }
  .pipeline__list { border-top: 1px solid var(--ft-ink); }
  .pipeline-step { display: grid; grid-template-columns: .35fr .55fr 1fr 1.3fr auto; gap: 2rem; align-items: center; padding: 1.6rem 0; border-bottom: 1px solid var(--ft-line); transition: padding .25s ease, background .25s ease; }
  .pipeline-step:hover { padding-inline: 1rem; background: color-mix(in srgb, var(--ft-acid) 18%, transparent); }
  .pipeline-step__number, .pipeline-step__label { font: 500 .67rem var(--ft-mono); }
  .pipeline-step__label { color: var(--ft-orange); text-transform: uppercase; }
  .pipeline-step h3 { margin: 0; font: 400 2rem var(--ft-serif); }
  .pipeline-step p { margin: 0; color: var(--ft-muted); font-size: .9rem; line-height: 1.55; }
  .pipeline-step__arrow { font-size: 1.5rem; }

  .trajectory { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 9rem); padding-block: 8rem; border-top: 1px solid var(--ft-line); }
  .trajectory__copy { align-self: center; }
  .trajectory__copy > p:not(.section-kicker) { max-width: 520px; color: var(--ft-muted); line-height: 1.75; }
  .trajectory__copy a, .track a { display: inline-block; margin-top: 1.2rem; color: var(--ft-ink); font: 600 .72rem var(--ft-mono); text-decoration: none; text-transform: uppercase; border-bottom: 1px solid; padding-bottom: .25rem; }
  .conversation { display: grid; gap: .65rem; padding: 1rem; border: 1px solid var(--ft-ink); background: var(--ft-ink); box-shadow: -18px 18px 0 var(--ft-orange); }
  .message { padding: 1rem; background: color-mix(in srgb, var(--ft-paper) 94%, var(--ft-blue)); color: var(--ft-ink); }
  .message span { font: 500 .56rem var(--ft-mono); letter-spacing: .08em; color: var(--ft-muted); }
  .message p { margin: .6rem 0 0; font-size: .88rem; line-height: 1.5; }
  .message--tool { margin-left: 2.5rem; background: var(--ft-blue); color: #171713; }
  .message--assistant { margin-right: 2.5rem; }
  .message--final { background: var(--ft-acid); color: #171713; }

  .capabilities { padding-block: 8rem; border-top: 1px solid var(--ft-line); }
  .capabilities__grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ft-ink); border-left: 1px solid var(--ft-line); }
  .capability { min-height: 260px; padding: 1.5rem; border-right: 1px solid var(--ft-line); border-bottom: 1px solid var(--ft-line); }
  .capability > span { font: 500 .58rem var(--ft-mono); color: var(--ft-orange); }
  .capability h3 { margin: 3.5rem 0 1rem; font: 400 2rem var(--ft-serif); }
  .capability p { margin: 0; color: var(--ft-muted); font-size: .88rem; line-height: 1.65; }
  .capability:hover { background: var(--ft-ink); color: var(--ft-paper); }
  .capability:hover p { color: color-mix(in srgb, var(--ft-paper) 70%, transparent); }

  .tracks { display: grid; grid-template-columns: 1fr 1fr; margin-bottom: 8rem; }
  .track { min-height: 600px; padding: clamp(2rem, 5vw, 4.5rem); border: 1px solid var(--ft-ink); }
  .track--chat { background: var(--ft-blue); color: #171713; transform: rotate(-.7deg); }
  .track--embed { margin-top: 3rem; margin-left: -1px; background: var(--ft-acid); color: #171713; transform: rotate(.7deg); }
  .track__label { font: 500 .65rem var(--ft-mono); letter-spacing: .1em; }
  .track h2 { margin: 4rem 0 1.3rem; font: 400 clamp(3.5rem, 6vw, 6rem)/.9 var(--ft-serif); }
  .track p { max-width: 500px; line-height: 1.7; }
  .track ul { margin: 3rem 0 0; padding: 0; list-style: none; border-top: 1px solid rgba(23,23,19,.4); }
  .track li { padding: .9rem 0; border-bottom: 1px solid rgba(23,23,19,.25); font: 500 .72rem var(--ft-mono); text-transform: uppercase; }
  .track a { color: #171713; }

  .safety { display: grid; grid-template-columns: .25fr .75fr 1fr; gap: 3rem; align-items: start; padding-block: 7rem; border-block: 1px solid var(--ft-line); }
  .safety__mark { display: grid; place-items: center; width: 70px; aspect-ratio: 1; border-radius: 50%; background: var(--ft-orange); color: #171713; font: 400 3rem var(--ft-serif); }
  .safety__body { color: var(--ft-muted); line-height: 1.7; }
  .safety__body p { margin: 0 0 1.2rem; }

  .closing { padding-block: 10rem; text-align: center; }
  .closing__hash { display: inline-block; margin-bottom: 2.5rem; padding: .55rem .8rem; border: 1px solid var(--ft-line); font: .63rem var(--ft-mono); color: var(--ft-muted); }
  .closing h2 { margin: 0; font: 400 clamp(5rem, 10vw, 10rem)/.78 var(--ft-serif); letter-spacing: -.05em; }
  .closing > p { max-width: 650px; margin: 3rem auto 0; color: var(--ft-muted); line-height: 1.7; }
  .closing .hero__actions { justify-content: center; }

  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease var(--delay, 0ms), transform .7s cubic-bezier(.2,.7,.2,1) var(--delay, 0ms); }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }

  @media (max-width: 900px) {
    .hero__grid, .manifesto, .section-head, .trajectory, .safety { grid-template-columns: 1fr; }
    .hero__grid { min-height: auto; padding-block: 4rem; }
    .hero h1 { font-size: clamp(4.6rem, 18vw, 8rem); }
    .run-card { margin: 1rem 18px 18px 0; }
    .manifesto__statement, .manifesto__body { grid-column: 1; }
    .manifesto__body { grid-template-columns: 1fr; gap: 1rem; }
    .pipeline-step { grid-template-columns: .3fr .5fr 1fr auto; }
    .pipeline-step p { grid-column: 3 / 5; }
    .capabilities__grid { grid-template-columns: repeat(2, 1fr); }
    .tracks { grid-template-columns: 1fr; }
    .track--embed { margin: -1px 0 0; }
    .safety { grid-template-columns: auto 1fr; }
    .safety__body { grid-column: 2; }
  }

  @media (max-width: 560px) {
    .landing .shell { width: min(100% - 24px, 1280px); }
    .hero { padding-top: 2rem; }
    .hero__version { display: none; }
    .hero h1 { font-size: clamp(4rem, 21vw, 6rem); }
    .hero__lede { font-size: 1rem; }
    .action { width: 100%; }
    .run-card__foot span:last-child, .run-event__state { display: none; }
